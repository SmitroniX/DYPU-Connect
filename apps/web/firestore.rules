rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Use Firestore-based role check safely
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    function isActive() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'banned';
    }

    function participant(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/private_chats/$(chatId)).data.get('participants', []);
    }

    function isGroupMember(groupId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupAdmin(groupId) {
      return signedIn() && (
        isAdmin() || 
        get(/databases/$(database)/documents/groups/$(groupId)).data.adminId == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if owner(userId)
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.role == "user" || (request.resource.data.role == "admin" && request.auth.token.email == "smitronix08@gmail.com")) // Whitelist admin
        && request.resource.data.status == "active";
      allow update: if (
        owner(userId)
        && request.resource.data.userId == resource.data.userId
        && (request.resource.data.role == resource.data.role || request.auth.token.email == "smitronix08@gmail.com") // Whitelist admin
        && request.resource.data.status == resource.data.status
      ) || isAdmin();
      allow delete: if isAdmin();

      match /activity_log/{logId} {
        allow read, create: if owner(userId);
      }

      match /sessions/{sessionId} {
        allow read, create, update: if owner(userId);
        allow delete: if owner(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow read, update, delete: if owner(userId);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['message', 'mention', 'group_invite', 'confession_reply'];
      }
    }

    match /public_chat/{docId} {
      allow read: if signedIn();
      allow create: if isActive() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
        (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'isDeleted']))
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.senderId == request.auth.uid);
    }

    match /anonymous_public_chat/{docId} {
      allow read: if signedIn();
      allow create: if isActive();
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
        (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'isDeleted']))
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.senderId == request.auth.uid);
    }

    match /confessions_public/{docId} {
      allow read: if signedIn();
      allow create: if isActive();
      allow update: if signedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'likesCount', 'commentsCount'])
      );
      allow delete: if isAdmin();

      match /likes/{likeUserId} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == likeUserId;
      }
      
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if isActive() && request.resource.data.userId == request.auth.uid;
        allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      // Only group admin or system admin can update group details
      allow update: if isGroupAdmin(groupId) || (
        signedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
        (
          // Joining group: only adding own uid
          (
            request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
            request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
            request.auth.uid in request.resource.data.memberIds
          ) ||
          // Leaving group: only removing own uid
          (
            resource.data.memberIds.hasAll(request.resource.data.memberIds) &&
            request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1 &&
            !(request.auth.uid in request.resource.data.memberIds)
          )
        )
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isGroupMember(groupId) || isAdmin();
        allow create: if isActive() && isGroupMember(groupId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isGroupMember(groupId) && (
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
           (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'isDeleted']))
        );
        allow delete: if isAdmin() || (isGroupMember(groupId) && resource.data.senderId == request.auth.uid);
      }
    }

    match /private_chats/{chatId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow read: if (signedIn() && request.auth.uid in resource.data.get('participants', [])) || isAdmin();
      allow update: if signedIn() && request.auth.uid in resource.data.get('participants', [])
        && request.resource.data.participants == resource.data.participants;
      allow delete: if isAdmin();
    }

    match /private_chats/{chatId}/messages/{msgId} {
      allow read: if participant(chatId) || isAdmin();
      allow create: if isActive() && participant(chatId) && request.resource.data.senderId == request.auth.uid;
      allow update: if participant(chatId) && (
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
         (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'isDeleted']))
      );
      allow delete: if participant(chatId) && (isAdmin() || resource.data.senderId == request.auth.uid);
    }

    match /calls/{callId} {
      allow read: if signedIn() 
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow create: if isActive() && request.resource.data.callerId == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);

      match /callerCandidates/{docId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
        allow write: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
      }
      match /calleeCandidates/{docId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
        allow write: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
      }
    }

    match /anonymous_public_chat_private/{docId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.messageId == docId;
      allow read, update, delete: if isAdmin();
    }

    match /confessions_private/{docId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.confessionId == docId;
      allow read, update, delete: if isAdmin();
    }

    match /reports/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /system_settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /admin_audit_log/{docId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
    }
  }
}
