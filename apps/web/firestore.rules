rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Use Firestore-based role check
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function participant(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/private_chats/$(chatId)).data.participants;
    }

    function isGroupMember(groupId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupAdmin(groupId) {
      return signedIn() && (
        isAdmin() || 
        get(/databases/$(database)/documents/groups/$(groupId)).data.adminId == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if owner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == "user" // Users cannot self-promote to admin on create
        && request.resource.data.status == "active";
      allow update: if (
        owner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.role == resource.data.role // Cannot change own role
        && request.resource.data.status == resource.data.status
      ) || isAdmin();
      allow delete: if isAdmin();

      match /activity_log/{logId} {
        allow read, create: if owner(userId);
      }

      match /sessions/{sessionId} {
        allow read, create, update: if owner(userId);
        allow delete: if owner(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow read, update, delete: if owner(userId);
        allow create: if signedIn();
      }
    }

    match /public_chat/{docId} {
      allow read, create: if signedIn();
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
        (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'isDeleted']))
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.senderId == request.auth.uid);
    }

    match /anonymous_public_chat/{docId} {
      allow read, create: if signedIn();
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
        (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'isDeleted']))
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.senderId == request.auth.uid);
    }

    match /confessions_public/{docId} {
      allow read, create: if signedIn();
      allow update: if signedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'likesCount'])
      );
      allow delete: if isAdmin();

      match /likes/{likeUserId} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == likeUserId;
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      // Only group admin or system admin can update group details
      allow update: if isGroupAdmin(groupId) || (
        signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isGroupMember(groupId) || isAdmin();
        allow create: if isGroupMember(groupId);
        allow update: if isGroupMember(groupId) && (
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
           (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'isDeleted']))
        );
        allow delete: if isAdmin() || (isGroupMember(groupId) && resource.data.senderId == request.auth.uid);
      }
    }

    match /private_chats/{chatId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow read: if (signedIn() && request.auth.uid in resource.data.participants) || isAdmin();
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();
    }

    match /private_chats/{chatId}/messages/{msgId} {
      allow read: if participant(chatId) || isAdmin();
      allow create: if participant(chatId);
      allow update: if participant(chatId) && (
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
         (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'isDeleted']))
      );
      allow delete: if isAdmin() || (participant(chatId) && resource.data.senderId == request.auth.uid);
    }

    match /calls/{callId} {
      allow read: if signedIn() 
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);

      match /callerCandidates/{docId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
        allow write: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
      }
      match /calleeCandidates/{docId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
        allow write: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
      }
    }

    match /anonymous_public_chat_private/{docId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.messageId == docId;
      allow read, update, delete: if isAdmin();
    }

    match /confessions_private/{docId} {
      allow read, write: if isAdmin();
    }

    match /reports/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /system_settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /admin_audit_log/{docId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
    }
  }
}
