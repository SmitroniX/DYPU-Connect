{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "typing": {
      "groups": {
        "$groupId": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && $uid === auth.uid"
          }
        }
      },
      "$chatId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && $uid === auth.uid"
        }
      }
    }
  }
}
