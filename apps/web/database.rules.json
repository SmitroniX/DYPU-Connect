{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "typing": {
      "$chatId": {
        ".read": "auth != null",
        "$uid": {
          // Users can only update their own typing status
          ".write": "auth != null && $uid === auth.uid"
        }
      }
    }
  }
}
